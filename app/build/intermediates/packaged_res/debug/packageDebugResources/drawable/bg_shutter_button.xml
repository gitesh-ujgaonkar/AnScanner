<?xml version="1.0" encoding="utf-8"?>
<!-- Shutter button: Mint green outer ring + solid inner circle -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/accent_mint" />
            <size
                android:width="@dimen/shutter_button_size"
                android:height="@dimen/shutter_button_size" />
        </shape>
    </item>

    <!-- Dark gap ring -->
    <item
        android:left="@dimen/shutter_button_ring_width"
        android:top="@dimen/shutter_button_ring_width"
        android:right="@dimen/shutter_button_ring_width"
        android:bottom="@dimen/shutter_button_ring_width">
        <shape android:shape="oval">
            <solid android:color="@color/background_primary" />
        </shape>
    </item>

    <!-- Inner solid circle -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/accent_mint" />
        </shape>
    </item>

</layer-list>
