<?xml version="1.0" encoding="utf-8"?>
<!-- Crop corner handle: Mint green circle with white stroke -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/crop_handle_fill" />
    <stroke
        android:width="@dimen/crop_handle_stroke_width"
        android:color="@color/crop_handle_stroke" />
    <size
        android:width="28dp"
        android:height="28dp" />
</shape>
