<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_background">

    <!-- ── Full-Screen Viewfinder & Document Boundary Overlay ───────────── -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.anscanner.app.ui.camera.DocumentOverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ── Top Controls Strip (Flash & Framing Hint) ────────────────────── -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/top_bar_height"
        android:background="#40000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_lg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottomSection"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_flash_toggle"
            android:src="@drawable/ic_flash_off"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvFramingHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/camera_framing_hint"
            android:textAppearance="@style/TextAppearance.AnScanner.Hint"
            android:textColor="@android:color/white" />

        <Space
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <!-- ── ID Card Step Floating Banner (Below Top Bar) ─────────────────── -->
    <LinearLayout
        android:id="@+id/layoutIdCardStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:backgroundTint="#80000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottomSection"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIdCardStepTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/id_card_step1_title"
                android:textAppearance="@style/TextAppearance.AnScanner.Label"
                android:textColor="@color/accent_mint"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIdCardStepDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/id_card_step1_hint"
                android:textAppearance="@style/TextAppearance.AnScanner.Caption"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIdCardRetakeFront"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/id_card_retake_front"
            android:textColor="@color/accent_mint"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ── Batch Mode Floating Strip (Above Camera Modes) ───────────────── -->
    <LinearLayout
        android:id="@+id/layoutBatchStrip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:backgroundTint="#80000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottomSection"
        app:layout_constraintBottom_toTopOf="@id/toggleMode">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBatchThumbs"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvBatchCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 pages"
                android:textAppearance="@style/TextAppearance.AnScanner.Caption"
                android:textColor="@color/accent_mint"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatchDone"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Review (0) →"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_on_accent"
                app:backgroundTint="@color/accent_mint"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Recent Scans Strip (Above Camera Modes) ──────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutRecentScans"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottomSection"
        app:layout_constraintBottom_toTopOf="@id/toggleMode">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/recent_scans"
                android:textAppearance="@style/TextAppearance.AnScanner.Label"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:text="@string/see_all"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textColor="@color/accent_mint" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentScans"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="2dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_recent_scan" />
    </LinearLayout>

    <!-- ── Camera Mode Switcher (Centered at Bottom) ───────────────────── -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@+id/btnModeDocument"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottomSection"
        app:layout_constraintBottom_toTopOf="@id/adView">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeDocument"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="0dp"
            android:text="@string/mode_document"
            android:textSize="11sp"
            android:textColor="@color/selector_camera_mode_text"
            app:backgroundTint="@color/selector_camera_mode_bg"
            app:strokeColor="@color/selector_camera_mode_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeBatch"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="0dp"
            android:text="@string/mode_batch"
            android:textSize="11sp"
            android:textColor="@color/selector_camera_mode_text"
            app:backgroundTint="@color/selector_camera_mode_bg"
            app:strokeColor="@color/selector_camera_mode_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeIdCard"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="0dp"
            android:text="@string/mode_id_card"
            android:textSize="11sp"
            android:textColor="@color/selector_camera_mode_text"
            app:backgroundTint="@color/selector_camera_mode_bg"
            app:strokeColor="@color/selector_camera_mode_stroke" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- ── Banner Ad (Centered at Bottom of Viewfinder, Never Clipped) ──── -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:adSize="BANNER"
        app:adUnitId="@string/admob_banner_ad_unit_id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/bottomSection"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ── Right Controls Panel: Under Right Thumb (Sleek 96dp Strip) ────── -->
    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="96dp"
        android:layout_height="0dp"
        android:background="#50000000"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_gallery_button"
            android:src="@drawable/ic_gallery"
            app:tint="@android:color/white" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <ImageButton
            android:id="@+id/btnScan"
            android:layout_width="@dimen/shutter_button_size"
            android:layout_height="@dimen/shutter_button_size"
            android:background="@drawable/bg_shutter_button"
            android:contentDescription="@string/cd_scan_button"
            android:src="@drawable/ic_camera"
            app:tint="@color/text_on_accent" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <ImageButton
            android:id="@+id/btnCompressPdf"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_compress_button"
            android:src="@drawable/ic_compress"
            app:tint="@android:color/white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
