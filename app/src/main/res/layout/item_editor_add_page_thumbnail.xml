<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAddThumbnail"
    android:layout_width="52dp"
    android:layout_height="70dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardPreventCornerOverlap="false"
    app:contentPadding="0dp"
    app:strokeColor="@color/accent_mint"
    app:strokeWidth="1.5dp"
    app:useCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageView
            android:id="@+id/ivAddIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/cd_add_page"
            android:src="@drawable/ic_add_page"
            app:tint="@color/accent_mint" />

        <TextView
            android:id="@+id/tvAddLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lines="1"
            android:text="@string/review_add_page"
            android:textColor="@color/accent_mint"
            android:textSize="9sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
