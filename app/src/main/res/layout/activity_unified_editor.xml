<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- ── 1. Top Clean Header ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Left: Close Button -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary" />

        <!-- Center: Dedicated Page Navigation (< Page X of Y >) -->
        <LinearLayout
            android:id="@+id/layoutPageNav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrevPage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_prev_page"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/bg_title_pill"
                android:ellipsize="end"
                android:gravity="center"
                android:minWidth="70dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:singleLine="true"
                android:text="Page 1 of 1"
                android:textAppearance="@style/TextAppearance.AnScanner.Title"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnNextPage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_next_page"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- Right: Actions (Undo, OCR, Save) -->
        <LinearLayout
            android:id="@+id/layoutRightActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_undo"
                android:enabled="false"
                android:alpha="0.3"
                android:src="@drawable/ic_undo"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_redo"
                android:enabled="false"
                android:alpha="0.3"
                android:src="@drawable/ic_redo"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnExtractText"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_extract_text"
                android:src="@drawable/ic_ocr_text"
                app:tint="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveDocument"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginStart="4dp"
                android:backgroundTint="@color/accent_mint"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/crop_confirm_save"
                android:textAppearance="@style/TextAppearance.AnScanner.Button"
                android:textColor="@color/text_on_accent"
                android:textSize="12sp"
                app:cornerRadius="18dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ── 2. Canvas Viewport (Center) ─────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/frameCenter"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background_primary"
        android:padding="4dp"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerPages"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.anscanner.app.ui.custom.LensOverlayView
            android:id="@+id/lensOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Floating Corner Magnifier / Loupe -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLoupe"
            android:layout_width="@dimen/loupe_size"
            android:layout_height="@dimen/loupe_size"
            android:layout_gravity="top|start"
            android:visibility="gone"
            app:cardBackgroundColor="@color/background_primary"
            app:cardCornerRadius="@dimen/loupe_corner_radius"
            app:cardElevation="10dp"
            app:cardPreventCornerOverlap="false"
            app:contentPadding="0dp"
            app:strokeColor="@color/accent_mint"
            app:strokeWidth="2dp"
            app:useCompatPadding="false">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivLoupe"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="matrix" />

                <ImageView
                    android:id="@+id/ivLoupeCrosshair"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_crosshair"
                    app:tint="@color/accent_mint" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- ── 3. Bottom Controls Container ────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- ── Annotation Sub-Toolbar (Visible during drawing mode) ─────── -->
        <LinearLayout
            android:id="@+id/layoutAnnotationBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_annotation_bar"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <!-- Tools Row: Pen, Highlighter, Stroke Width, Clear, Done -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnToolPen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_pen"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/accent_mint" />

                <ImageButton
                    android:id="@+id/btnToolHighlighter"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_highlighter"
                    android:src="@drawable/ic_ocr_text"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/btnStrokeWidth"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_title_pill"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="@string/stroke_width_medium"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnClearAnnotation"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/annotate_clear"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDoneAnnotation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="@color/accent_mint"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/action_done"
                    android:textColor="@color/text_on_accent"
                    android:textSize="12sp"
                    app:cornerRadius="16dp" />
            </LinearLayout>

            <!-- Brush Size Slider Drawer (with dynamic real-time circular preview) -->
            <LinearLayout
                android:id="@+id/layoutBrushSizeDrawer"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:visibility="gone">

                <!-- Circular Indicator Preview Box -->
                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_title_pill">
                    <View
                        android:id="@+id/viewBrushPreviewCircle"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_mint" />
                </FrameLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderBrushSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="6dp"
                    android:valueFrom="2.0"
                    android:valueTo="40.0"
                    android:value="8.0"
                    android:stepSize="1.0"
                    app:thumbColor="@color/accent_mint"
                    app:trackColorActive="@color/accent_mint"
                    app:trackColorInactive="@color/border_subtle" />

                <TextView
                    android:id="@+id/tvBrushSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="38dp"
                    android:text="8 dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Color Palette Row (with outer selection rings + Custom Color Wheel) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="2dp">

                <!-- Slot 1: Mint Green #68D391 -->
                <FrameLayout
                    android:id="@+id/containerColorMint"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="3dp">
                    <View
                        android:id="@+id/ringMint"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:visibility="visible" />
                    <View
                        android:id="@+id/colorMint"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_mint" />
                </FrameLayout>

                <!-- Slot 2: Red #EF4444 -->
                <FrameLayout
                    android:id="@+id/containerColorRed"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="3dp">
                    <View
                        android:id="@+id/ringRed"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:visibility="gone" />
                    <View
                        android:id="@+id/colorRed"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_red" />
                </FrameLayout>

                <!-- Slot 3: Black #111827 -->
                <FrameLayout
                    android:id="@+id/containerColorBlack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="3dp">
                    <View
                        android:id="@+id/ringBlack"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:visibility="gone" />
                    <View
                        android:id="@+id/colorBlack"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_black" />
                </FrameLayout>

                <!-- Slot 4: White #FFFFFF with subtle border -->
                <FrameLayout
                    android:id="@+id/containerColorWhite"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="3dp">
                    <View
                        android:id="@+id/ringWhite"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:visibility="gone" />
                    <View
                        android:id="@+id/colorWhite"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_white" />
                </FrameLayout>

                <!-- Slot 5: Yellow #FACC15 -->
                <FrameLayout
                    android:id="@+id/containerColorYellow"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="3dp">
                    <View
                        android:id="@+id/ringYellow"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:visibility="gone" />
                    <View
                        android:id="@+id/colorYellow"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_yellow" />
                </FrameLayout>

                <!-- Slot 6: Blue #3B82F6 -->
                <FrameLayout
                    android:id="@+id/containerColorBlue"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="3dp">
                    <View
                        android:id="@+id/ringBlue"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:visibility="gone" />
                    <View
                        android:id="@+id/colorBlue"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_blue" />
                </FrameLayout>

                <!-- Slot 7: Custom HSV Color Wheel Picker -->
                <FrameLayout
                    android:id="@+id/containerColorCustom"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="3dp">
                    <View
                        android:id="@+id/ringCustom"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_ring"
                        android:visibility="gone" />
                    <ImageView
                        android:id="@+id/btnCustomDrawingColor"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Custom Color"
                        android:src="@drawable/ic_color_lens"
                        app:tint="@color/text_primary" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Text Annotation Styling Sub-Toolbar (Visible when a text box is selected) ── -->
        <LinearLayout
            android:id="@+id/layoutTextToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_annotation_bar"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <!-- Primary Actions Row: Edit Text, Font "Aa", Color, Size, Bg, Delete, Done -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 1. Keyboard: Edit Text Content -->
                <ImageButton
                    android:id="@+id/btnTextEditText"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Edit Text"
                    android:src="@drawable/ic_keyboard"
                    app:tint="@color/text_primary" />

                <!-- 2. Typography Font Picker -->
                <TextView
                    android:id="@+id/btnTextFontPicker"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_title_pill"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Aa Font"
                    android:textColor="@color/accent_mint"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- 3. Text Color Picker Swatch -->
                <FrameLayout
                    android:id="@+id/btnTextColorPicker"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp">
                    <View
                        android:id="@+id/textColorPreviewCircle"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_mint" />
                </FrameLayout>

                <!-- 4. Text Size Toggle -->
                <TextView
                    android:id="@+id/btnTextSizeToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_title_pill"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="18sp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <!-- 5. Background Pill Toggle -->
                <ImageButton
                    android:id="@+id/btnTextBgToggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle Background"
                    android:src="@drawable/ic_brightness"
                    app:tint="@color/text_secondary" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- 6. Delete Text -->
                <ImageButton
                    android:id="@+id/btnTextDelete"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete Text"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/error_red" />

                <!-- 7. Done / Close Selection -->
                <ImageButton
                    android:id="@+id/btnTextDone"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Done"
                    android:src="@drawable/ic_check"
                    app:tint="@color/accent_mint" />
            </LinearLayout>

            <!-- Expandable Font Selector Row (Chips for Sans, Serif, Mono, Script, Bold Condensed) -->
            <HorizontalScrollView
                android:id="@+id/scrollFontOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/layoutFontChips"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Expandable Text Size Slider Row -->
            <LinearLayout
                android:id="@+id/layoutTextSizeSlider"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvTextSizeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="38dp"
                    android:text="18sp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderTextSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="10.0"
                    android:valueTo="64.0"
                    android:value="18.0"
                    android:stepSize="1.0"
                    app:thumbColor="@color/accent_mint"
                    app:trackColorActive="@color/accent_mint"
                    app:trackColorInactive="@color/border_subtle" />
            </LinearLayout>

            <!-- Expandable Text Color Palette Row -->
            <LinearLayout
                android:id="@+id/layoutTextColorPalette"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ── Filter Sub-Toolbar (Visible during filter mode) ─────────── -->
        <LinearLayout
            android:id="@+id/layoutFilterBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_annotation_bar"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <!-- Filter Header with Apply to All Checkbox and Done Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FILTERS"
                    android:textAppearance="@style/TextAppearance.AnScanner.SectionHeader"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <!-- Subtle loading indicator when applying filter to main viewport -->
                <ProgressBar
                    android:id="@+id/pbFilterApplying"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/accent_mint"
                    android:visibility="gone" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbFilterApplyToAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="@string/filter_apply_to_all"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    app:buttonTint="@color/accent_mint" />

                <ImageButton
                    android:id="@+id/btnCloseFilter"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_close"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <!-- Horizontal Filter Thumbnail Carousel -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="4dp"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- ── Horizontal Thumbnail Strip (Batch Scan / Multi-Page) ────── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvThumbnails"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp" />

        <!-- ── Bottom Quick-Action Toolbar ─────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            app:cardBackgroundColor="#161B22"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:contentPadding="0dp"
            app:strokeColor="#21262D"
            app:strokeWidth="1dp"
            app:useCompatPadding="false">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <!-- 1. Crop Button -->
                    <LinearLayout
                        android:id="@+id/btnCrop"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="64dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/crop_action_crop"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:id="@+id/ivCropIcon"
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_crop"
                            app:tint="@color/color_nav_item" />

                        <TextView
                            android:id="@+id/tvCropLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:letterSpacing="0.02"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/crop_action_crop"
                            android:textAppearance="@style/TextAppearance.AnScanner.Label"
                            android:textColor="@color/color_nav_item"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 2. Filter Button -->
                    <LinearLayout
                        android:id="@+id/btnFilter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="64dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/crop_action_filter"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:id="@+id/ivFilterIcon"
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_filter"
                            app:tint="@color/color_nav_item" />

                        <TextView
                            android:id="@+id/tvFilterLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:letterSpacing="0.02"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/crop_action_filter"
                            android:textAppearance="@style/TextAppearance.AnScanner.Label"
                            android:textColor="@color/color_nav_item"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 3. Draw Button -->
                    <LinearLayout
                        android:id="@+id/btnAnnotate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="64dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/action_draw"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:id="@+id/ivAnnotateIcon"
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/color_nav_item" />

                        <TextView
                            android:id="@+id/tvAnnotateLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:letterSpacing="0.02"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/action_draw"
                            android:textAppearance="@style/TextAppearance.AnScanner.Label"
                            android:textColor="@color/color_nav_item"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 4. Text / Signature Button -->
                    <LinearLayout
                        android:id="@+id/btnTextSign"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="64dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/action_text_sign"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:id="@+id/ivTextSignIcon"
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_signature"
                            app:tint="@color/color_nav_item" />

                        <TextView
                            android:id="@+id/tvTextSignLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:letterSpacing="0.02"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/action_text_sign"
                            android:textAppearance="@style/TextAppearance.AnScanner.Label"
                            android:textColor="@color/color_nav_item"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 5. Rotate Button -->
                    <LinearLayout
                        android:id="@+id/btnRotate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="64dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/crop_action_rotate"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:id="@+id/ivRotateIcon"
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rotate"
                            app:tint="@color/color_nav_item" />

                        <TextView
                            android:id="@+id/tvRotateLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:letterSpacing="0.02"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/crop_action_rotate"
                            android:textAppearance="@style/TextAppearance.AnScanner.Label"
                            android:textColor="@color/color_nav_item"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 6. Delete Button -->
                    <LinearLayout
                        android:id="@+id/btnDelete"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minWidth="64dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/crop_action_delete"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:id="@+id/ivDeleteIcon"
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:duplicateParentState="true"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_delete"
                            app:tint="@color/color_nav_delete" />

                        <TextView
                            android:id="@+id/tvDeleteLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:duplicateParentState="true"
                            android:ellipsize="end"
                            android:letterSpacing="0.02"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="@string/crop_action_delete"
                            android:textAppearance="@style/TextAppearance.AnScanner.Label"
                            android:textColor="@color/color_nav_delete"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>