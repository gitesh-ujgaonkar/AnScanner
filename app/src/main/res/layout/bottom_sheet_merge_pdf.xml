<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_card"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="@dimen/bottom_sheet_drag_handle_width"
        android:layout_height="@dimen/bottom_sheet_drag_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_title_pill"
        android:backgroundTint="@color/text_muted" />

    <!-- Header: Title, Subtitle, and Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMergeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/merge_title"
                android:textAppearance="@style/TextAppearance.AnScanner.Headline"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvMergeSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.AnScanner.Subtitle"
                android:textColor="@color/text_secondary"
                android:text="@string/merge_reorder_hint" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_close"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="12dp" />

    <!-- File Name Input Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilFileName"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:hint="@string/merge_file_name_label"
        app:boxStrokeColor="@color/accent_mint"
        app:hintTextColor="@color/accent_mint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Documents Section Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="6dp"
        android:text="@string/merge_documents_header"
        android:textAppearance="@style/TextAppearance.AnScanner.Label"
        android:textColor="@color/text_secondary" />

    <!-- Reorderable List of Documents -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMergeDocs"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_mint"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Progress Layout (Visible during merge) -->
    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressMerge"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:indeterminate="true"
            app:indicatorColor="@color/accent_mint"
            app:trackColor="@color/surface_card"
            app:trackCornerRadius="3dp" />

        <TextView
            android:id="@+id/tvProgressStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.AnScanner.Caption"
            android:textColor="@color/text_secondary"
            android:text="@string/merge_progress" />
    </LinearLayout>

    <!-- Primary Action: Merge PDFs -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMerge"
        style="@style/Widget.AnScanner.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="20dp"
        android:text="@string/merge_action_btn"
        app:icon="@drawable/ic_merge_pdf"
        app:iconTint="@color/text_on_accent"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />

</LinearLayout>
