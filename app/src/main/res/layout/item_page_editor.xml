<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="6dp"
    android:background="@color/background_primary">

    <!-- 1. Base Image Layer -->
    <com.anscanner.app.ui.custom.TouchImageView
        android:id="@+id/ivPageImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <!-- 2. Interactive CropOverlayView (hidden by default) -->
    <com.anscanner.app.ui.crop.CropOverlayView
        android:id="@+id/cropOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 3. AnnotationDrawingView (transparent overlay) -->
    <com.anscanner.app.ui.custom.AnnotationDrawingView
        android:id="@+id/drawingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>