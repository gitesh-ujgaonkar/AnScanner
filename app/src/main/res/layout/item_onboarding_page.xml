<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="32dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="70dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/accent_mint"
        app:strokeWidth="2dp">

        <ImageView
            android:id="@+id/ivOnboardingIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_camera"
            app:tint="@color/accent_mint" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvOnboardingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="@string/onboarding_slide1_title"
        android:textAppearance="@style/TextAppearance.AnScanner.Headline"
        android:textColor="@color/text_primary"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/tvOnboardingDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/onboarding_slide1_desc"
        android:textAppearance="@style/TextAppearance.AnScanner.Body"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

</LinearLayout>
