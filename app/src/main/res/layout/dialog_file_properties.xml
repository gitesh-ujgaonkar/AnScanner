<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <!-- File Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/properties_file_name"
            android:textAppearance="@style/TextAppearance.AnScanner.Label"
            android:textColor="@color/accent_mint" />

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.AnScanner.Body"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true" />
    </LinearLayout>

    <!-- Location Path -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/properties_location"
            android:textAppearance="@style/TextAppearance.AnScanner.Label"
            android:textColor="@color/accent_mint" />

        <TextView
            android:id="@+id/tvFilePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.AnScanner.Body"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true" />
    </LinearLayout>

    <!-- File Size -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/properties_file_size"
            android:textAppearance="@style/TextAppearance.AnScanner.Label"
            android:textColor="@color/accent_mint" />

        <TextView
            android:id="@+id/tvFileSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.AnScanner.Body"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Date Modified -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/properties_date_modified"
            android:textAppearance="@style/TextAppearance.AnScanner.Label"
            android:textColor="@color/accent_mint" />

        <TextView
            android:id="@+id/tvDateModified"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.AnScanner.Body"
            android:textColor="@color/text_primary" />
    </LinearLayout>

</LinearLayout>
