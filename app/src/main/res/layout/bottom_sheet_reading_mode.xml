<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/ic_drag_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_reading_mode"
            app:tint="@color/accent_mint"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/reading_settings"
            android:textAppearance="@style/TextAppearance.AnScanner.Title"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btnCloseSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Theme Section Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reading_theme"
        android:textAppearance="@style/TextAppearance.AnScanner.Label"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="10dp" />

    <!-- Theme Selector Chips / Cards -->
    <LinearLayout
        android:id="@+id/layoutThemes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <!-- Light Theme -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeLight"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="2dp"
            app:strokeColor="@color/accent_mint">

            <TextView
                android:id="@+id/tvThemeLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/reading_theme_light"
                android:textColor="#111827"
                android:textStyle="bold"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Sepia Theme -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeSepia"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/reading_sepia_card"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider">

            <TextView
                android:id="@+id/tvThemeSepia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/reading_theme_sepia"
                android:textColor="#5C4827"
                android:textStyle="bold"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Dark Theme -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeDark"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/reading_dark_card"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider">

            <TextView
                android:id="@+id/tvThemeDark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/reading_theme_dark"
                android:textColor="#E5E7EB"
                android:textStyle="bold"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Night Theme -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeNight"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#000000"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider">

            <TextView
                android:id="@+id/tvThemeNight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/reading_theme_night"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Margins Section Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reading_margins"
        android:textAppearance="@style/TextAppearance.AnScanner.Label"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="10dp" />

    <!-- Margins Toggle Group -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroupMargins"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarginCompact"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="@string/reading_margin_compact"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarginNormal"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="@string/reading_margin_normal"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarginWide"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="@string/reading_margin_wide"
            android:textAllCaps="false"
            android:textSize="12sp" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Page by Page Snap Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/reading_page_snap"
            android:textAppearance="@style/TextAppearance.AnScanner.Subtitle"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchPageSnap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Keep Awake Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/reading_keep_awake"
            android:textAppearance="@style/TextAppearance.AnScanner.Subtitle"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchKeepAwake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
